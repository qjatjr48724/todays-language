rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 기본 정책: 본인 users/{uid}와 하위 컬렉션은 본인만 접근 가능
    match /users/{uid} {
      allow read, create, update, delete: if isSelf(uid);

      match /{subCollection}/{docId} {
        allow read, write: if isSelf(uid);
      }
    }

    // 글로벌 세트(Functions가 소유/작성, 앱은 읽기만)
    match /users/global_learning_set_owner/{doc=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // 공개 메타데이터(국가 목록/국기 URL 등): 로그인 사용자 read-only
    match /public_metadata/{doc=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // 탈퇴 후 재가입 금지(이메일 해시) — Functions 전용
    match /account_recreation_blocks/{docId} {
      allow read, write: if false;
    }

    function userTargetLanguage() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.targetLanguage;
    }

    function isSupportedChatRoom(roomId) {
      return roomId in ['KOR', 'USA', 'JPN'];
    }

    // 언어별 공개 채팅 — 학습 언어(targetLanguage)와 방 ID가 일치하는 사용자만 읽기/쓰기
    match /chat_rooms/{roomId}/messages/{messageId} {
      allow read: if isSignedIn()
        && isSupportedChatRoom(roomId)
        && userTargetLanguage() == roomId;

      allow create: if isSignedIn()
        && isSupportedChatRoom(roomId)
        && userTargetLanguage() == roomId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.targetLanguage == roomId
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.displayName is string
        && request.resource.data.createdAtMs is int;

      allow update, delete: if false;
    }
  }
}

